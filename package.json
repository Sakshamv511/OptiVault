{
  "name": "optivault",
  "version": "1.0.0",
  "description": "OptiVault — Warehouse Slot Allocation & Packing Optimizer (React Frontend + Express Backend)",
  "scripts": {
    "start": "node Backend/server.js",
    "server": "node Backend/server.js",
    "dev:backend": "nodemon Backend/server.js",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build:frontend": "npm --prefix Frontend run build",
    "build": "npm --prefix Frontend run build",
    "test": "node Backend/scripts/test-workflow.js",
    "db:view": "node Backend/scripts/view-db.js",
    "db:seed": "node Backend/scripts/seed-warehouse.js"
  }
}
